+/* 7931: GPU_OVERLAP=1 per-batch fences. Patch 2907 dropped render_frame's full GPU drain and leaned on
+ * move_to_next_frame, which waits only on presents: a batch that does not present (a mid-frame flush, an offscreen-only
+ * batch) keeps the same frame index, so the next prepare reset a command allocator, a texture-ring part and the GPU_TIME
+ * readback the GPU could still be using, and the grave freed objects two batch counts later, whatever the GPU was doing.
+ * Here every batch signals its own value on a fence of its own right after its ExecuteCommandLists, and the CPU waits
+ * for exactly what it is about to reuse:
+ *   - before prepare resets frame index fi's allocator / ring part / readback: the last batch that used fi;
+ *   - after the upload halves flip (vp_parity), before the FIFO thread records into a half: the last batch that used it;
+ *   - a graved object: every batch that may name it (all executed ones, the one in the submit thread, the one recording);
+ *   - rare in-place rewrites (font atlas, CPU scanout buffer): all executed batches.
+ * With PIPE=1 (two-thread drawing) the FIFO thread records batch N+1 while the submit thread builds N and the GPU may
+ * still run N-1; the halves alternate, so the parity wait after the hand-off is what keeps N+1 off N-1's half.
+ * Values are written by the thread that executes (the submit thread with PIPE=1) and read by the FIFO thread only after
+ * pipe_wait (event order), except the counter itself (interlocked). Nothing here touches guest memory. */
+static struct {
+    ID3D12Fence* fence;
+    volatile LONG64 seq;            /* last value signalled (one per executed batch) */
+    u64 alloc[FRAME_COUNT];         /* last value of a batch on frame index i's allocator */
+    u64 par[2];                     /* last value of a batch that read upload half p */
+    u64 n_wait_alloc, n_wait_par, n_wait_all, n_batches;
+    double ms_alloc, ms_par, ms_all;
+} s_ovl;
+static void ovl_init(void)   /* backend init, after the device: before any frame, so the switch never changes mid-run */
+{
+    if (s_ovl.fence || !gpu_overlap_on()) return;
+    if (FAILED(s_d3d.device->lpVtbl->CreateFence(s_d3d.device, 0, D3D12_FENCE_FLAG_NONE, &IID_ID3D12Fence, (void**)&s_ovl.fence))) {
+        s_ovl.fence = NULL; s_ovl_no_fence = 1;
+        fprintf(stderr, "[OVERLAP] fence not created: GPU_OVERLAP off, render_frame drains the GPU as before%c", 10);
+    }
+}
+static u64 ovl_seq(void) { return (u64)InterlockedCompareExchange64(&s_ovl.seq, 0, 0); }
+static u64 ovl_completed(void)
+{
+    return s_ovl.fence ? s_ovl.fence->lpVtbl->GetCompletedValue(s_ovl.fence) : ~(u64)0;
+}
+/* A graved object may be named by every executed batch, by the batch the submit thread holds and by the batch being
+ * recorded: at most two batches beyond the counter (a stale read of the counter is at most one behind, and then the
+ * submit thread's batch is the one that just executed). */
+static u64 ovl_grave_target(void) { return ovl_seq() + 2; }
+/* Signal after a batch's ExecuteCommandLists (the thread that executed it). */
+static void ovl_after_execute(u32 fi, int parity)
+{
+    if (!gpu_overlap_on() || !s_ovl.fence) return;
+    const u64 v = (u64)InterlockedIncrement64(&s_ovl.seq);
+    s_d3d.cmd_queue->lpVtbl->Signal(s_d3d.cmd_queue, s_ovl.fence, v);
+    s_ovl.alloc[fi % FRAME_COUNT] = v;
+    s_ovl.par[parity & 1] = v;
+    s_ovl.n_batches++;
+}
+/* Wait until the GPU passed v (kind: 0 allocator, 1 upload half, 2 everything); a no-op unless GPU_OVERLAP=1 (no fence).
+ * As long as the device lives, like wait_for_gpu (patch 2066). The HITCH probe counts it as GPU wait. */
+static void ovl_wait(u64 v, int kind)
+{
+    if (!v || !s_ovl.fence) return;
+    if (s_ovl.fence->lpVtbl->GetCompletedValue(s_ovl.fence) >= v) return;
+    static _Thread_local HANDLE ev = NULL;
+    if (!ev) ev = CreateEventA(NULL, FALSE, FALSE, NULL);
+    const double t0 = hz_now();
+    if (!ev) { s_ovl.fence->lpVtbl->SetEventOnCompletion(s_ovl.fence, v, NULL); }   /* NULL: blocks until done */
+    else {
+        s_ovl.fence->lpVtbl->SetEventOnCompletion(s_ovl.fence, v, ev);
+        for (int tries = 0;; tries++) {
+            if (WaitForSingleObject(ev, 2000) != WAIT_TIMEOUT) break;
+            const HRESULT rr = s_d3d.device->lpVtbl->GetDeviceRemovedReason(s_d3d.device);
+            fprintf(stderr, "[OVERLAP] fence wait STUCK %ds: want %llu got %llu removed=0x%08lX%c", 2 * (tries + 1),
+                    (unsigned long long)v, (unsigned long long)ovl_completed(), (long)rr, 10);
+            if (rr != 0) break;
+        }
+    }
+    const double ms = hz_now() - t0;
+    if (hz_ms()) { s_hz_t[3] += ms; s_hz_n[3]++; }
+    if (kind == 0) { s_ovl.n_wait_alloc++; s_ovl.ms_alloc += ms; }
+    else if (kind == 1) { s_ovl.n_wait_par++; s_ovl.ms_par += ms; }
+    else { s_ovl.n_wait_all++; s_ovl.ms_all += ms; }
+}
+static void ovl_wait_all(void) { if (gpu_overlap_on()) ovl_wait(ovl_seq(), 2); }
+/* [OVERLAP] every 600 batches: how often and how long the CPU still waited for the GPU, by reason (counters written by two
+ * threads with PIPE=1: approximate, diagnostic only). */
+static void ovl_report(void)
+{
+    if (!gpu_overlap_on() || !s_ovl.n_batches || (s_ovl.n_batches % 600) != 0) return;
+    fprintf(stderr, "[OVERLAP] %llu batches: allocator waits %llu (%.1f ms), upload-half waits %llu (%.1f ms), full waits %llu (%.1f ms)%c",
+            (unsigned long long)s_ovl.n_batches, (unsigned long long)s_ovl.n_wait_alloc, s_ovl.ms_alloc,
+            (unsigned long long)s_ovl.n_wait_par, s_ovl.ms_par, (unsigned long long)s_ovl.n_wait_all, s_ovl.ms_all, 10);
+}
