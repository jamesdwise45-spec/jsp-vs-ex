+/* Patch 3012 (part 8): the fast pace, in virtual time. Ticks of given lengths through the real output (stretch on, 300 ms device, cushion 90):
+ * the gaps, the gaps within 1.5 s of another (a "chop cluster"), the lowest rate and the largest step of the rate per tick. */
+typedef struct { unsigned long long gaps, clustered, fast, squeezed, drops; double rmin, max_step, lvl_mean, lvl_max; } fast_result;
+static double s_fp[6000]; static int s_fn;
+static void fp_add(double ms, int n) { for (int i = 0; i < n && s_fn < 6000; i++) s_fp[s_fn++] = ms + (prnd() - 0.5) * 4.0; }   /* +-2 ms jitter */
+static fast_result run_fast(int fast, UINT32 dev)
+{
+    static fake_dev d; fake_init(&d, dev);
+    wasapi_dev w = fake_wasapi(&d, 60); wasapi_adopt(&w);
+    ps3r_audio_dev_opened(&s_wasapi_st, GetTickCount64() + 3600 * 1000ull);
+    lk_begin();
+    const int cu = s_lk_cushion_ms, drc = s_lk_drc, sm = s_lk_slow_min, rf = s_lk_refill, st = s_lk_stretch, fa = s_lk_fast;
+    s_lk_cushion_ms = 90; s_lk_drc = 4; s_lk_ff = 1; s_lk_slow_min = 60; s_lk_refill = 1; s_lk_stretch = 1; s_lk_fast = fast;
+    s_lk_test_ms = 0.0;
+    fast_result r; memset(&r, 0, sizeof r); r.rmin = 1.0;
+    double owed = 0.0, last_gap = -1e9, prev = 1.0, lsum = 0.0; long long blocks = 0; unsigned long long g = s_lk_conceals; int nl = 0;
+    for (int t = 0; t < s_fn; t++) {
+        s_lk_burst = 1; g_ps3_audio_lock_stretch_us = 0;
+        if (t >= 150) { lsum += d.padding / 48.0; nl++; if (d.padding / 48.0 > r.lvl_max) r.lvl_max = d.padding / 48.0; }   /* the low point before the burst, from 5 s */
+        for (; blocks < (long long)(t + 1) * 25 / 4; blocks++) { tone((int)blocks); lk_submit_block(); }
+        if (s_lk_slow_out < r.rmin) r.rmin = s_lk_slow_out;
+        if (fabs(s_lk_slow_out - prev) > r.max_step) r.max_step = fabs(s_lk_slow_out - prev); prev = s_lk_slow_out;
+        owed += s_fp[t] * 48.0;
+        for (int k = 0; owed >= 48.0; k++) { play(&d, 48); owed -= 48.0; s_lk_test_ms += 1.0; if (k & 1) lk_idle_tail(); }
+        if (s_lk_conceals != g) { if (s_lk_test_ms - last_gap < 1500.0) r.clustered += s_lk_conceals - g; last_gap = s_lk_test_ms; g = s_lk_conceals; }
+    }
+    CHECK(s_lk_blocks == (unsigned long long)blocks);
+    r.gaps = s_lk_conceals; r.fast = s_lk_fast_bursts; r.squeezed = s_lk_squeezed; r.drops = s_lk_drops; r.lvl_mean = nl ? lsum / nl : 0.0;
+    lk_end();
+    s_lk_cushion_ms = cu; s_lk_drc = drc; s_lk_slow_min = sm; s_lk_refill = rf; s_lk_stretch = st; s_lk_fast = fa; s_lk_test_ms = -1.0;
+    return r;
+}
+static void test_fast_pace(void)
+{
+    static const char* nm[6] = { "steady 30 ticks/s", "single 60-150 ms hitches", "lumpy slow patches", "runs of 45-55 ms ticks",
+                                 "76 ms hitches ~3 s, 300 ms", "76 ms hitches ~2 s, 200 ms" };
+    for (int sc = 0; sc < 6; sc++) {
+        fast_result r[2];
+        for (int f = 0; f < 2; f++) {
+            s_prng = 4242 + sc; s_fn = 0;
+            if (sc == 0) fp_add(1000.0 / 30.0, 1800);
+            if (sc == 1) for (int k = 0; k < 15; k++) { fp_add(1000.0 / 30.0, 90); s_fp[s_fn++] = k % 3 == 0 ? 60.0 : k % 3 == 1 ? 90.0 : 150.0; }
+            if (sc == 2) for (int k = 0; k < 8; k++) { fp_add(1000.0 / 30.0, 200); for (int j = 0; j < 35; j++) s_fp[s_fn++] = prnd() < 0.45 ? 50.0 + prnd() * 30.0 : 1000.0 / 30.0; }
+            if (sc == 3) for (int k = 0; k < 8; k++) { fp_add(1000.0 / 30.0, 150); fp_add(k & 1 ? 55.0 : 45.0, 20); }
+            if (sc == 4) for (int k = 0; k < 40; k++) { fp_add(1000.0 / 30.0, 90); s_fp[s_fn++] = 76.0; }   /* review of 3012: absorbed hitches */
+            if (sc == 5) for (int k = 0; k < 60; k++) { fp_add(1000.0 / 30.0, 60); s_fp[s_fn++] = 76.0; }
+            r[f] = run_fast(f, sc == 5 ? 9600 : 14400);
+        }
+        printf("fast pace %-27s: off %3llu gaps (%3llu clustered), on %3llu gaps (%3llu clustered), %4llu fast bursts, rate min %.2f, largest step %.3f; "
+               "low point mean / max off %.0f / %.0f ms, on %.0f / %.0f ms; squeezed+dropped off %llu, on %llu\n",
+               nm[sc], r[0].gaps, r[0].clustered, r[1].gaps, r[1].clustered, r[1].fast, r[1].rmin, r[1].max_step,
+               r[0].lvl_mean, r[0].lvl_max, r[1].lvl_mean, r[1].lvl_max, r[0].squeezed + r[0].drops, r[1].squeezed + r[1].drops);
+        CHECK(r[1].squeezed + r[1].drops <= r[0].squeezed + r[0].drops);         /* review: no more squeezed or dropped blocks than without it */
+        /* review: no lasting overshoot (extra delay) past the cushion (90 ms) or past what it was without (off often sits under the cushion) */
+        CHECK(r[1].lvl_mean <= fmax(r[0].lvl_mean, 90.0) + 15.0 && r[1].lvl_max <= fmax(r[0].lvl_max, 110.0) + 30.0);
+        CHECK(r[1].max_step <= LK_FAST_DOWN * LK_SLOW_DT_MAX + 1e-9);            /* never a jump: the ramps hold */
+        CHECK(r[1].rmin >= 0.60 - 1e-9);                                          /* never under AUDIO_LOCK_SLOW_MIN */
+        if (sc == 0) CHECK(r[1].gaps == r[0].gaps && r[1].fast <= 15);            /* steady: only the start's first ticks (its first gap) */
+        if (sc == 1 || sc >= 4) CHECK(r[1].gaps <= r[0].gaps);                   /* single hitches: never worse */
+        if (sc == 2 || sc == 3) CHECK(r[1].gaps * 3 <= r[0].gaps && r[1].clustered * 3 <= r[0].clustered);   /* slow patches: at least 3x fewer chops */
+    }
+}
+
 int main(int argc, char** argv)
 {
     vm_base = (uint8_t*)VirtualAlloc(NULL, 0x100000, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
@@ -611,6 +674,7 @@ int main(int argc, char** argv)
     test_slow_pace();
     test_refill();
