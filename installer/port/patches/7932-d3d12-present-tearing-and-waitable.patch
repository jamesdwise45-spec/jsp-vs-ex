-    int                        tearing;     /* D3D12_VSYNC=0 and the swap chain allows tearing */
+    int                        tearing;     /* D3D12_VSYNC=0 (or PRESENT_TEAR=1, 7932) and the swap chain allows tearing */
+    HANDLE                     latency_wait; /* 7932 WAITABLE_SC: the swap chain's frame-latency object, or NULL */
     ID3D12DescriptorHeap*      rtv_heap;
     u32                        rtv_descriptor_size;
     ID3D12Resource*            render_targets[FRAME_COUNT];
@@ -1192,7 +1193,35 @@ static int d3d12_present_mode(void)
     }
     return mode;
 }
-static int d3d12_vsync_off(void) { return d3d12_present_mode() == 2; }   /* the swap chain asks for tearing only then */
+static int d3d12_vsync_off(void) { return d3d12_present_mode() == 2; }   /* D3D12_VSYNC=0 (PRESENT_TEAR=1 also asks for tearing, 7932) */
+/* 7932 (present path, both off by default; read once at swap-chain creation):
+ * PRESENT_TEAR=1: in the default present mode (no vblank wait) also pass DXGI_PRESENT_ALLOW_TEARING when DXGI supports it
+ *   (Microsoft's advice for windowed and borderless flip-model games: it lets a borderless window that owns the screen use
+ *   independent flip / VRR and skip the compositor's extra frame). A composed window looks the same as before; a borderless
+ *   one that gets independent flip can tear, like D3D12_VSYNC=0. With D3D12_VSYNC=1 (sync interval 1) the flag is never
+ *   passed, as DXGI requires.
+ * WAITABLE_SC=<1-3>: a frame-latency waitable swap chain (SetMaximumFrameLatency(n)). The thread that presents waits on its
+ *   object before it records a batch that presents (bounded at 100 ms, then it carries on), so a GPU or compositor that is
+ *   behind holds the CPU at the start of a frame instead of letting presents queue up (lower input-to-screen latency). It is
+ *   the same wait Present would do, earlier; the HITCH probe counts it under "Present". Nothing the guest reads changes.
+ *   With GPU_OVERLAP=1 n is at least 2: with 1 the wait would hold the submit thread until the GPU finished (and the
+ *   compositor showed) the previous batch, the drain the overlap removes. After a timeout the missed count is taken back
+ *   with zero-timeout waits on later presents, so one long hitch does not raise the latency for the rest of the run. */
+static int gpu_overlap_on(void);
+static int present_tear_on(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("PRESENT_TEAR"); v = (e && *e == '1') ? 1 : 0; }
+    return v;
+}
+static int waitable_sc_n(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("WAITABLE_SC"); v = e ? atoi(e) : 0; if (v < 0) v = 0; if (v > 3) v = 3;
+                 if (v == 1 && gpu_overlap_on()) {
+                     v = 2; fprintf(stderr, "[D3D12] WAITABLE_SC=1 with GPU_OVERLAP=1: using 2 (1 would undo the overlap)%c", 10); } }
+    return v;
+}
 
