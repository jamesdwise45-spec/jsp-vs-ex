+        if (tear) sc_desc.Flags |= DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING;
+        printf("[D3D12] %s: tearing %s\n", d3d12_vsync_off() ? "D3D12_VSYNC=0" : "PRESENT_TEAR=1", tear ? "allowed" : "not supported");
