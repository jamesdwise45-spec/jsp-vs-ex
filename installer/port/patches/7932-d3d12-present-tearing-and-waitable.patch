+    if (f->present && s_d3d.latency_wait) {   /* 7932 WAITABLE_SC: the frame-latency wait, before this batch's commands */
+        static u32 s_lw_n = 0; static double s_lw_ms = 0; static u32 s_lw_to = 0, s_lw_debt = 0;
