+/* 7929: the window lives on its own thread, which does nothing but pump its messages (WINDOW_THREAD=0: on the calling thread, the
+ * old way). Before, the window belonged to the thread that also drains the FIFO and gives the guest its vblanks (the port's frame
+ * clock), and DispatchMessage runs DefWindowProc's modal loops in place: holding the title bar or a frame edge (move / size), the
+ * window menu (Alt, Alt+Space, a click on the icon) and any slow message sent by another process (overlays, hooks) stopped the
+ * whole game for as long as they lasted (an 865 ms pump in one online match). Now only this thread waits in them; the drawing
+ * thread's pump finds no window messages. Nothing the guest sees changes (presentation and input only): the keys are read with
+ * GetAsyncKeyState and the focus by process, both thread-independent, and the in-game text panel's calls take their own lock.
+ * The thread runs one step above normal unless HOST_PRIO=0, because Present / SetWindowText on the submit thread can send it a
+ * message and wait for the answer. It never waits on the drawing threads, so a sent message cannot deadlock. */
+static struct { u32 w, h; const char* title; HWND hwnd; HANDLE ready; } s_wt;
+static DWORD WINAPI win_thread_main(LPVOID arg)
+{
+    (void)arg;
+    { const char* e = getenv("HOST_PRIO");
+      if (!(e && *e == '0')) SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_ABOVE_NORMAL); }
+    s_wt.hwnd = create_window(s_wt.w, s_wt.h, s_wt.title);
+    const HWND h = s_wt.hwnd;
+    SetEvent(s_wt.ready);   /* s_wt is the creator's from here on */
+    if (!h) return 0;
+    MSG m;
+    for (;;) {
+        const BOOL r = GetMessageA(&m, NULL, 0, 0);
+        if (r == 0 || r == -1) break;   /* WM_QUIT (the window was destroyed) or an error */
+        TranslateMessage(&m);
+        DispatchMessageA(&m);
+    }
+    InterlockedExchange((volatile LONG*)&s_d3d.window_closed, 1);   /* the frame clock's pump reports it and the game quits */
+    return 0;
+}
+static HWND create_window_threaded(u32 width, u32 height, const char* title)
+{
+    const char* e = getenv("WINDOW_THREAD");
+    if (e && *e == '0') {
+        fprintf(stderr, "[D3D12] window thread: off (WINDOW_THREAD=0), the window's messages are pumped by the drawing thread%c", 10);
+        return create_window(width, height, title);
+    }
+    s_wt.w = width; s_wt.h = height; s_wt.title = title; s_wt.hwnd = NULL;
+    s_wt.ready = CreateEventA(NULL, TRUE, FALSE, NULL);
+    InterlockedExchange(&s_win_thread, 1);   /* before the thread runs: its window procedure takes the threaded close path */
+    HANDLE th = s_wt.ready ? CreateThread(NULL, 0, win_thread_main, NULL, 0, NULL) : NULL;
+    if (!th) {
+        InterlockedExchange(&s_win_thread, 0);
+        if (s_wt.ready) { CloseHandle(s_wt.ready); s_wt.ready = NULL; }
+        fprintf(stderr, "[D3D12] window thread: not created (error %lu), the window stays on the drawing thread%c", (unsigned long)GetLastError(), 10);
+        return create_window(width, height, title);
+    }
+    WaitForSingleObject(s_wt.ready, INFINITE);
+    CloseHandle(s_wt.ready); s_wt.ready = NULL;
+    const HWND h = s_wt.hwnd;
+    const DWORD tid = GetThreadId(th);
+    CloseHandle(th);
+    if (!h) { InterlockedExchange(&s_win_thread, 0); return NULL; }   /* the thread has returned; init fails as before */
+    fprintf(stderr, "[D3D12] window thread: on (tid %lu), the window's messages no longer run on the drawing thread (WINDOW_THREAD=0 = the old way)%c",
+            (unsigned long)tid, 10);
+    return h;
+}
