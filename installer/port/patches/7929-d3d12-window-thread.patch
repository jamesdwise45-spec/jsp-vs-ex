+static volatile LONG s_win_thread = 0;   /* 1: the window belongs to win_thread_main */
+static volatile LONG s_init_failed = 0;  /* 1: rsx_d3d12_backend_init failed after the window was made: nobody polls the closed flag */
+#define WM_JSP_DESTROY (WM_APP + 0x29)  /* shutdown: the only DestroyWindow in threaded mode, on the owner thread */
+/* Esc, the close button and rsx_d3d12_request_close. Threaded (7929): set the flag the frame clock's pump reports and hide the window,
+ * but do not destroy it: the submit thread may be inside Present or SetWindowTextA for it right now. It is destroyed at shutdown
+ * (WM_JSP_DESTROY) or with the process. When the backend never came up, nothing reads the flag (main.cpp stops pumping on a failed
+ * init), so the process ends here, as "End task" on the unanswered window did before. WINDOW_THREAD=0: destroy at once, as before. */
+static void win_close(HWND hwnd)
+{
+    InterlockedExchange((volatile LONG*)&s_d3d.window_closed, 1);
+    if (!s_win_thread) { DestroyWindow(hwnd); return; }
