+/* 7934 VPULL_VRAM=1 (experiment, off by default): the GPU reads this batch's vertex bytes and indices from video memory.
+ * VPULL's byte ring and the index buffer live in UPLOAD heaps, i.e. system memory: every vertex-shader Load of a pulled
+ * vertex and every index fetch crosses PCIe. J-Stars fights pull nearly all draws (test10 desktop: 1.4-1.7 GB/s of vertex
+ * bytes, 60-80 MB per batch at 3200-4000 draws). With the switch, the start of each batch's draw loop copies the used span of
+ * its ring half (+ the Load2 slack) and of its index half into one DEFAULT-heap mirror each (CopyBufferRegion: a bulk
+ * transfer), and the draws bind the mirrors at the same offsets. The CPU writes exactly as before; nothing the guest reads
+ * changes. One mirror serves every batch: batches run in queue order, and each copy is fenced by its own barriers (buffers
+ * decay to COMMON between ExecuteCommandLists). Costs ring+16 MB of video memory and one copy per batch (GPU_TIME=1 shows it
+ * as "vram-copy"). No mirror (allocation failed, VPULL off): the old binding. */
+static struct { int on; ID3D12Resource* ring; ID3D12Resource* ib; u64 n, bytes; u32 hwm; } s_vv = { -1, NULL, NULL, 0, 0, 0 };
+/* The batch's highest ring offset so far (a guard: s_vpull.off only grows within a batch today). */
+static u32 vv_ring_hwm(void) { if (s_vpull.off > s_vv.hwm) s_vv.hwm = s_vpull.off; return s_vv.hwm; }
+static int vpull_vram_on(void)
+{
+    if (s_vv.on < 0) { const char* e = getenv("VPULL_VRAM"); s_vv.on = (e && *e == '1') ? 1 : 0; }
+    return s_vv.on;
+}
