+/* From np_psnr_pump: send the held requests whose probe was answered, ran out of time, or lost its socket. */
+static void held_flush(uint64_t now)
+{
+    for (int i = 0; i < HELD_MAX; i++) {
+        LOCK();
+        struct held h = s_held[i];
+        int due = h.used && (s_probed || !s_p2p_send || !s_client || now - h.since >= HOLD_MS);
+        if (due) memset(&s_held[i], 0, sizeof(s_held[i]));
+        int probed = s_probed;
+        UNLOCK();
+        if (!due) continue;
+        printf("[psnr] room request held %u ms for the P2P socket's probe (%s)\n", (unsigned)(now - h.since),
+               probed ? "answered" : "not answered: sent anyway");
+        if (!np_psnr_request(h.type, h.body, h.len, h.fn, h.user) && h.fn) {
+            psnr_msg dead;   /* not sent (no connection): fail it the way a lost connection does */
+            memset(&dead, 0, sizeof(dead));
+            h.fn(h.user, &dead);
+        }
+        free(h.body);
+    }
