+    p->moved_port = from_port;
+    p->stats_due = 1;
+    if (!switch_on(getenv("PSNR_PUNCH_LEARN"))) return;
+    if (p->seen_port == from_port && !memcmp(p->seen_ip, from_ip, 4)) {
+        p->heard_at = now;   /* the learned port again */
+        return;
+    }
