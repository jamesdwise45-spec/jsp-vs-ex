+
+/* Whether the relay carries this player's datagrams and streams. GET_CAPS bit 5 is what says so: HELLO_ACK's flag
+ * describes the server, not the player, and a server under -require-pass relay drops every relayed datagram of a player
+ * without a relay pass (re-psn docs/api.md: "Only GET_CAPS bit 5 says whether this player can use the relay").
+ * A server older than GET_CAPS has no passes, so its HELLO_ACK flag stands. PSNR_RELAY_NEEDS_CAPS=0: the HELLO_ACK
+ * flag alone, as before. Callers hold LOCK. */
+static int relay_ok(void)
+{
+    if (!s_client) return 0;
+    if (!switch_on(getenv("PSNR_RELAY_NEEDS_CAPS"))) return psnr_relay_available(s_client);
+    if (s_caps_state == CAPS_ANSWERED) return (s_caps_bits & PSNR_CAP_RELAY) != 0;
+    if (s_caps_state == CAPS_OLD_SERVER) return psnr_relay_available(s_client);
+    return 0;
+}
+
+static void on_caps(void* user, const psnr_msg* m)
+{
+    psnr_caps caps;
+    (void)user;
+    LOCK();
+    int relay_flag = s_client && psnr_relay_available(s_client);
+    if (psnr_caps_parse(m, &caps)) {
+        s_caps_state = CAPS_ANSWERED;
+        s_caps_bits = caps.bits;
+    } else if (m->type == PSNR_ERROR && m->len >= 4 && psnr_get32(m->data) == PSNR_E_BAD_REQUEST) {
+        s_caps_state = CAPS_OLD_SERVER;
+    } else {
+        s_caps_state = CAPS_NONE;   /* no answer (the connection went) or one we can't read */
+    }
+    int state = s_caps_state;
+    uint32_t bits = s_caps_bits;
+    UNLOCK();
+    if (state == CAPS_ANSWERED)
+        printf("[psnr] server capabilities 0x%x: the relay %s\n", (unsigned)bits,
+               (bits & PSNR_CAP_RELAY) ? "carries this player's datagrams" :
+               (bits & CAP_PASS_RELAY) ? "needs a relay pass this player does not have: datagrams stay direct" :
+               relay_flag ? "is not offered to this player (HELLO_ACK said it was): datagrams stay direct" :
+                            "is off on this server");
+    else if (state == CAPS_OLD_SERVER)
+        printf("[psnr] the server predates GET_CAPS: the relay is %s (HELLO_ACK)\n", relay_flag ? "on" : "off");
+    else
+        printf("[psnr] no capability answer from the server: the relay is not used\n");
+}
+
+static void caps_ask(void)
+{
+    LOCK();
+    s_caps_state = CAPS_WAITING;
+    s_caps_bits = 0;
+    UNLOCK();
+    if (!np_psnr_request(PSNR_GET_CAPS, NULL, 0, on_caps, NULL)) {
+        LOCK();
+        s_caps_state = CAPS_NONE;
+        UNLOCK();
+    }
+}
