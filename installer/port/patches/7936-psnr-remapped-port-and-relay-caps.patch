+/* The peer whose learned endpoint (from its punches) is ip:port. */
+static struct peer* peer_seen_at(const uint8_t ip[4], uint16_t port)
+{
+    for (int i = 0; i < MAX_PEERS; i++)
+        if (s_peers[i].user && s_peers[i].seen_port && s_peers[i].seen_port == port && !memcmp(s_peers[i].seen_ip, ip, 4))
+            return &s_peers[i];
+    return NULL;
