+ * CreateRoom sent meanwhile went out before the held request. Off, every request is sent at once, in order, as before. */
+uint32_t np_psnr_request_after_probe(uint8_t type, const void* body, uint32_t len, np_psnr_reply_fn fn, void* user)
+{
+    LOCK();
+    const char* on = getenv("PSNR_JOIN_AFTER_PROBE");
+    int hold = on && on[0] == '1' && !on[1] && s_client && s_p2p_send && !s_probed;
+    struct held* h = NULL;
+    for (int i = 0; hold && i < HELD_MAX && !h; i++)
+        if (!s_held[i].used) h = &s_held[i];
+    if (h && (h->body = (uint8_t*)malloc(len ? len : 1)) != NULL) {
+        if (len) memcpy(h->body, body, len);
+        h->used = 1;
+        h->type = type;
+        h->len = len;
+        h->fn = fn;
+        h->user = user;
+        h->since = nat_now_ms();
+        UNLOCK();
+        return 1;   /* nonzero: taken; the reply comes through fn as for np_psnr_request */
+    }
+    UNLOCK();
+    return np_psnr_request(type, body, len, fn, user);
+}
