+static void on_caps(void* user, const psnr_msg* m)
+{
+    psnr_caps caps;
+    (void)user;
+    LOCK();
+    int relay_flag = s_client && psnr_relay_available(s_client);
+    if (psnr_caps_parse(m, &caps)) {
+        s_caps_state = CAPS_ANSWERED;
+        s_caps_bits = caps.bits;
+    } else if (m->type == PSNR_ERROR && m->len >= 4 && psnr_get32(m->data) == PSNR_E_BAD_REQUEST) {
+        s_caps_state = CAPS_OLD_SERVER;
+    } else {
