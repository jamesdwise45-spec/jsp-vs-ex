+    p->seen_port = from_port;
+    p->learned = 1;
+    if (p->punches_left < REPUNCHES) p->punches_left = REPUNCHES;   /* answer there, so its side hears us */
+    p->next_punch = 0;
+    p->heard_at = now;
+    if (p->relay_udp) {
+        p->relay_udp = 0;
+        printf("[psnr] user %u: its datagrams go direct again, to the learned port\n", p->user);
+    }
