+/* ---- 4. patch 3008: the time-sync stretch fed forward ---- */
+typedef struct { unsigned long long conceals, dry, bursts, stretched; double fb_max, tot_max, level_mean; } ff_result;
+static ff_result run_stretch(double stretch_ms, int ff, int seconds)
+{
+    static fake_dev d;
+    fake_init(&d, 7200);   /* 150 ms, as AUDIO_LOCK_BUF_MS opens it */
+    wasapi_dev w = fake_wasapi(&d, 60); wasapi_adopt(&w);
+    ps3r_audio_dev_opened(&s_wasapi_st, GetTickCount64() + 3600 * 1000ull);
+    lk_begin(); s_lk_ff = ff;
+    g_ps3_audio_lock_stretch_us = (int)(stretch_ms * 1000.0 + 0.5);   /* what the game thread writes at every boundary */
+    const int ticks = seconds * 30, warm = 10 * 30;   /* the first 10 s fill the cushion from an empty device (as at a real lock start) */
+    unsigned long long c0 = 0, d0 = 0; double owed = 0.0, lsum = 0.0; long long blocks = 0; int nl = 0;
+    for (int t = 0; t < ticks; t++) {
+        if (t == warm) { c0 = s_lk_conceals; d0 = s_lk_dry; s_lk_skew_min = s_lk_skew_max = s_lk_tot_min = s_lk_tot_max = 0; }
+        if (t >= warm) { lsum += d.padding; nl++; }
+        s_lk_burst = 1;   /* the mix thread waited: the next block starts a burst */
+        for (; blocks < (long long)(t + 1) * 25 / 4; blocks++) { tone((int)blocks); lk_submit_block(); }
+        owed += 1600.0 + 48.0 * stretch_ms;   /* the stretched tick period, in device frames: played 1 ms at a time, the idle tail every 2 ms */
+        for (int k = 0; owed >= 48.0; k++) { play(&d, 48); owed -= 48.0; if (k & 1) lk_idle_tail(); }
+    }
+    CHECK(s_lk_blocks == (unsigned long long)blocks);   /* every block sent once: the stretch changes the output's length only */
+    ff_result r = { s_lk_conceals - c0, s_lk_dry - d0, s_lk_bursts, s_lk_ff_bursts, s_lk_skew_max, s_lk_tot_max, nl ? lsum / nl / 48.0 : 0.0 };
+    lk_end();
+    g_ps3_audio_lock_stretch_us = 0;
+    return r;
+}
+static void test_stretch_feed_forward(void)
