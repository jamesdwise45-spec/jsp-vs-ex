+        const ff_result on = run_stretch(st[i], 1, 40), off = run_stretch(st[i], 0, 40);
+        printf("stretch %.1f ms/tick, 30 s after the start: feed-forward on %llu concealed gaps, %llu dry, feedback max %+.2f %%, total max %+.2f %%, level %.1f ms;"
+               " off %llu concealed gaps, %llu dry, feedback max %+.2f %%, level %.1f ms\n", st[i], on.conceals, on.dry, on.fb_max * 100, on.tot_max * 100, on.level_mean,
+               off.conceals, off.dry, off.fb_max * 100, off.level_mean);
+        CHECK(on.stretched == on.bursts && off.stretched == off.bursts);        /* every burst saw the stretch, also with the feed-forward off */
+        CHECK(on.conceals == 0 && on.dry == 0);                                 /* on: no gap once the cushion is there */
+        CHECK(on.fb_max < cap * 0.5);                                           /* ... the feedback is not pinned */
+        CHECK(on.level_mean > 40.0 && on.level_mean < 60.0);                    /* ... and the level sits at the 50 ms cushion */
+        CHECK(fabs(on.tot_max - (st[i] / (1000.0 / 30.0) + on.fb_max)) < 1e-9); /* the total is the stretch plus the feedback */
+        if (st[i] >= 1.0) CHECK(off.conceals > 0 && off.fb_max > cap * 0.5);   /* off: 3007 as it was: drained, concealing, the feedback near its cap */
+    }
+    /* the total cap: a 2 ms stretch with AUDIO_LOCK_DRC=12 on an empty device would be 6.0 + 4.7 %: held at 8 %, and the block fits in LK_OUTMAX */
+    static fake_dev d;
