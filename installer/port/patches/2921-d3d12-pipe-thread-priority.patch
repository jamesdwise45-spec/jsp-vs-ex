+/* 2921: the submit thread (draw loop, Execute, Present) runs one step above normal, like the title's high-priority PPU threads and the
+ * port's FIFO drain thread, and opts out of EcoQoS (execution-speed power throttling). On a hybrid CPU under Windows 10 (no Thread
+ * Director) a normal-priority or throttled thread can be left on an efficiency core behind them. Host scheduling only: nothing the title
+ * reads changes. HOST_PRIO=0 leaves both at the Windows default. SetThreadInformation is looked up at run time (Windows 8+; values from
+ * processthreadsapi.h: ThreadPowerThrottling = 3, THREAD_POWER_THROTTLING_CURRENT_VERSION = 1, ..._EXECUTION_SPEED = 0x1). */
+static void pipe_thread_tune(void)
+{
+    const char* e = getenv("HOST_PRIO");
+    if (e && *e == '0') { fprintf(stderr, "[PIPE] thread: HOST_PRIO=0, Windows default priority and power throttling%c", 10); return; }
+    const int prio = SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_ABOVE_NORMAL) ? 1 : 0;
+    struct { ULONG Version, ControlMask, StateMask; } ts = { 1u, 0x1u, 0u };   /* StateMask 0 = never throttle this thread */
+    typedef BOOL (WINAPI *set_ti_fn)(HANDLE, int, LPVOID, DWORD);
+    const set_ti_fn set = (set_ti_fn)(void*)GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "SetThreadInformation");
+    const int eco = (set && set(GetCurrentThread(), 3, &ts, (DWORD)sizeof ts)) ? 1 : 0;
+    fprintf(stderr, "[PIPE] thread: priority above normal %s, EcoQoS off %s%c", prio ? "ok" : "failed", eco ? "ok" : "failed", 10);
+}
