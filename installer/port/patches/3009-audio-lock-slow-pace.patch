+/* ---- 5. patch 3009: slow pace ---- */
+/* tick_ms for the whole run, or until switch_s and tick2_ms after it; uneven_ms > 0: each tick 33.3 ms plus an exponential wait of that mean;
+ * hitch_every_s: a 76 ms hitch about that often (+-1 s), with big_hitches every third one 150-300 ms; stretch_ms: published at every boundary and
+ * added to the tick (as the time sync does); stall_ms at stall_s: one long stall */
+typedef struct { const char* name; double tick_ms, tick2_ms, switch_s, stretch_ms, uneven_ms, hitch_every_s; int big_hitches; double seconds, stall_s, stall_ms; } pace;
+typedef struct { unsigned long long conceals, conceals_late, conceals2, squeezed, drops, entries;
+                 double slow_end, slow_lo, slow_ms, max_step, lvl_mean, slow_mid, back_ms; } pace_result;
+static unsigned s_prng = 99;
+static double prnd(void) { s_prng = s_prng * 1103515245u + 12345u; return ((s_prng >> 8) & 0xFFFF) / 65536.0; }
+static pace_result run_pace(const pace* pc, int slow_min)
+{
+    static fake_dev d;
+    fake_init(&d, 9600);   /* 200 ms, AUDIO_LOCK_BUF_MS as the J-Stars port sets it */
+    wasapi_dev w = fake_wasapi(&d, 60); wasapi_adopt(&w);
+    ps3r_audio_dev_opened(&s_wasapi_st, GetTickCount64() + 3600 * 1000ull);
+    lk_begin();
+    const int cu = s_lk_cushion_ms, drc = s_lk_drc, sm = s_lk_slow_min;
+    s_lk_cushion_ms = 90; s_lk_drc = 8; s_lk_ff = 1; s_lk_slow_min = slow_min; s_prng = 99;
+    s_lk_test_ms = 0.0;
+    pace_result r; memset(&r, 0, sizeof r); r.back_ms = -1.0;
+    unsigned long long c_late = 0, c_sw = 0; int late_set = 0, sw_set = 0;
+    double owed = 0.0, lsum = 0.0, next_hitch = pc->hitch_every_s * 1000.0, prev = 1.0; long long blocks = 0; int nl = 0, hitches = 0, stalled = 0;
+    for (int t = 0; s_lk_test_ms < pc->seconds * 1000.0; t++) {
+        const double now = s_lk_test_ms;
+        const int phase2 = pc->switch_s > 0 && now >= pc->switch_s * 1000.0;
+        if (!late_set && now >= 15000.0) { c_late = s_lk_conceals; late_set = 1; }   /* settled: from 15 s */
+        if (phase2 && !sw_set) { c_sw = s_lk_conceals; sw_set = 1; r.slow_mid = s_lk_slow_out; }
+        if (now >= 15000.0) { lsum += d.padding; nl++; }
+        s_lk_burst = 1;
+        g_ps3_audio_lock_stretch_us = (int)(pc->stretch_ms * 1000.0 + 0.5);
+        for (; blocks < (long long)(t + 1) * 25 / 4; blocks++) { tone((int)blocks); lk_submit_block(); }
+        const double step = fabs(s_lk_slow_out - prev); if (step > r.max_step) r.max_step = step; prev = s_lk_slow_out;
+        if (sw_set && r.back_ms < 0 && !s_lk_slow_eng) r.back_ms = now - pc->switch_s * 1000.0;
+        double period = (phase2 ? pc->tick2_ms : pc->tick_ms) + pc->stretch_ms;
+        if (pc->uneven_ms > 0 && !phase2) period = 1000.0 / 30.0 + pc->stretch_ms - log(1.0 - prnd() * 0.999) * pc->uneven_ms;
+        if (pc->hitch_every_s > 0 && now >= next_hitch) {
+            hitches++; period += pc->big_hitches && hitches % 3 == 0 ? 150.0 + 150.0 * prnd() : 76.0;
+            next_hitch += (pc->hitch_every_s - 1.0 + 2.0 * prnd()) * 1000.0;
+        }
+        if (pc->stall_ms > 0 && !stalled && now >= pc->stall_s * 1000.0) { period += pc->stall_ms; stalled = 1; }
+        owed += period * 48.0;   /* the device plays the tick period, 1 ms at a time, the idle tail every 2 ms */
+        for (int k = 0; owed >= 48.0; k++) { play(&d, 48); owed -= 48.0; s_lk_test_ms += 1.0; if (k & 1) lk_idle_tail(); }
+    }
+    CHECK(s_lk_blocks == (unsigned long long)blocks);   /* every block sent once: only the output's length changes */
+    r.conceals = s_lk_conceals; r.conceals_late = s_lk_conceals - c_late; r.conceals2 = sw_set ? s_lk_conceals - c_sw : 0;
+    r.squeezed = s_lk_squeezed; r.drops = s_lk_drops; r.entries = s_lk_slow_entries;
+    r.slow_end = s_lk_slow_out; r.slow_lo = s_lk_slow_lo; r.slow_ms = s_lk_slow_ms; r.lvl_mean = nl ? lsum / nl / 48.0 : 0.0;
+    printf("slow pace %-26s %s: %4llu concealed gaps (%3llu after 15 s), %2llu squeezed, %2llu dropped, slow %llu times %.1f s, rate min %.3f end %.3f,"
+           " largest step per tick %.4f, level from 15 s %.1f ms\n", pc->name, slow_min ? "on " : "off", r.conceals, r.conceals_late,
+           r.squeezed, r.drops, r.entries, r.slow_ms / 1000.0, r.slow_lo, r.slow_end, r.max_step, r.lvl_mean);
+    if (sw_set) printf("    at the switch to %.1f ms ticks the rate was %.3f; back to 1 and disengaged %.0f ms later; %llu concealed gaps after the switch\n",
+                       pc->tick2_ms, r.slow_mid, r.back_ms, r.conceals2);
+    g_ps3_audio_lock_stretch_us = 0;
+    lk_end();
+    s_lk_cushion_ms = cu; s_lk_drc = drc; s_lk_slow_min = sm; s_lk_test_ms = -1.0;
+    return r;
+}
+static void test_slow_pace(void)
+{
+    static const pace steady = { "steady 30 ticks/s",        1000.0 / 30.0, 0, 0, 0.0, 0, 0, 0, 60, 0, 0 };
+    static const pace hitch  = { "76 ms hitches ~12 s",      1000.0 / 30.0, 0, 0, 0.0, 0, 12.0, 0, 120, 0, 0 };
+    static const pace field  = { "field hitches ~11 s",      1000.0 / 30.0, 0, 0, 0.0, 0, 11.0, 1, 120, 0, 0 };
+    static const pace dense  = { "76 ms hitches ~3 s",       1000.0 / 30.0, 0, 0, 0.0, 0, 3.0, 0, 120, 0, 0 };
+    static const pace slow   = { "20 ticks/s",               50.0, 0, 0, 0.0, 0, 0, 0, 60, 0, 0 };
+    static const pace slows  = { "20 ticks/s, 2 ms stretch", 48.0, 0, 0, 2.0, 0, 0, 0, 60, 0, 0 };
+    /* test9's time sync stretches the fast PC's ticks by up to 25 ms to follow a slow peer: the feed-forward plays at most 8 % of it */
+    static const pace big1   = { "20/s = 33.3 + 16.7 stretch", 1000.0 / 30.0, 0, 0, 16.7, 0, 0, 0, 60, 0, 0 };
+    static const pace big2   = { "23/s with a 25 ms stretch", 1000.0 / 23.0 - 25.0, 0, 0, 25.0, 0, 0, 0, 60, 0, 0 };
+    static const pace big3   = { "17/s = 33.3 + 25 stretch", 1000.0 / 30.0, 0, 0, 25.0, 0, 0, 0, 60, 0, 0 };
+    static const pace uneven = { "uneven ~20 ticks/s",       0, 0, 0, 0.0, 16.7, 0, 0, 60, 0, 0 };
+    static const pace rec    = { "20 -> 30 ticks/s at 30 s", 50.0, 1000.0 / 30.0, 30.0, 0.0, 0, 0, 0, 60, 0, 0 };
+    static const pace stall  = { "20 ticks/s, 2 s stall",    50.0, 0, 0, 0.0, 0, 0, 0, 60, 30.0, 2000.0 };
+    static const pace slower = { "12 ticks/s",               1000.0 / 12.0, 0, 0, 0.0, 0, 0, 0, 40, 0, 0 };
+    pace_result a = run_pace(&steady, 60), a0 = run_pace(&steady, 0);
+    CHECK(a.entries == 0 && a.slow_lo == 1.0 && a.conceals == a0.conceals && a.squeezed == a0.squeezed && a.drops == a0.drops);   /* (a) as before */
