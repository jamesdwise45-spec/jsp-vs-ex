+    pace_result f = run_pace(&field, 60), f0 = run_pace(&field, 0);
+    CHECK(f.entries == 0 && f.slow_lo == 1.0 && f.conceals == f0.conceals);
+    pace_result dn = run_pace(&dense, 60);
+    CHECK(dn.entries == 0);                                                    /* 2.5 % slower on average: not a slow pace */
+    pace_result c = run_pace(&slow, 60), c0 = run_pace(&slow, 0);
+    CHECK(c.entries == 1 && c.conceals_late == 0 && c.drops == 0 && fabs(c.slow_end - 2.0 / 3.0) < 0.02);   /* (c) */
+    CHECK(c0.entries == 0 && c0.conceals_late > 100);                          /* AUDIO_LOCK_SLOW_MIN=0: 3008 as it was */
+    pace_result cs = run_pace(&slows, 60);                                     /* the stretch is fed forward, the slow pace makes up the rest */
+    CHECK(cs.entries == 1 && cs.conceals_late == 0 && cs.drops == 0);
+    const pace* bigs[] = { &big1, &big2, &big3 };
+    for (int i = 0; i < 3; i++) {   /* engaged, no concealed gap once settled, nothing dropped, and the rate makes up what the 8 % cap leaves */
+        pace_result g = run_pace(bigs[i], 60), g0 = run_pace(bigs[i], 0);
+        const double period = bigs[i]->tick_ms + bigs[i]->stretch_ms, want = (1000.0 / 30.0) / period * (1.0 + LK_SKEW_MAX);
