index 74263d8..c30f377 100644
--- a/libs/audio/cellAudio.c
+++ b/libs/audio/cellAudio.c
@@ -1044,6 +1044,83 @@ static void lk_slow_burst(double ff, int level, int cushion)
     if (s_lk_slow_out < s_lk_slow_lo) s_lk_slow_lo = s_lk_slow_out;
 }
 /* The rate the resampler plays this block at: from where the last burst left it to s_lk_slow_out over the first 6 blocks of the burst. */
+/* J-Stars patch 3011 (AUDIO_LOCK_STRETCH=0 turns it off: 3010 as it was): a pitch-preserving time stretch (WSOLA) in place of the linear resampler.
+ * The rate the output plays at (3007 feedback, 3008 feed-forward, 3009/3010 slow pace and refill: 0.55 to 1.1) changed the pitch with the speed: a
+ * refill at +6.25 % was a semitone flat, the slow pace at 0.6 almost a fifth. Now each block's input goes into a ring; grains of LK_WS_W frames with a
+ * periodic Hann window are overlap-added every LK_WS_HS output frames (50 %, so the windows sum to exactly 1), and each grain's input start moves
+ * by LK_WS_HS x the rate (the analysis hop) from the last one's nominal start, then up to LK_WS_TOL frames either way to the place that best continues
+ * the grain before it (normalised cross-correlation of the overlap, mono: a coarse pass every 4th offset on every 2nd frame, then +-3 at every
+ * frame). At rate 1 the best place is the nominal one and the output is the input, delayed. Costs: about LK_WS_TOL + LK_WS_W - LK_WS_HS frames
+ * (9 ms) of delay held in the ring (the device level control is unchanged; the delay adds to it), and a few hundred us per burst. No allocation:
+ * every buffer is static. A block puts out 0, 1 or 2 grains (LK_WS_HS frames each), so the output comes in steps of LK_WS_HS frames. */
+#define LK_WS_W     480                  /* grain: 10 ms */
+#define LK_WS_HS    (LK_WS_W / 2)        /* synthesis hop */
+#define LK_WS_TOL   200                  /* the search, either way: 4.2 ms (half the period of a 120 Hz voice) */
+#define LK_WS_RING  4096                 /* input frames kept (a power of 2) */
+_Static_assert((LK_WS_RING & (LK_WS_RING - 1)) == 0 && LK_WS_RING > 2 * LK_WS_TOL + LK_WS_W + 4 * LK_N, "the WSOLA ring holds a search and a block");
+_Static_assert(LK_OUTMAX >= 2 * LK_WS_HS && LK_WS_HS >= LK_F, "two grains fit in a block's output, and a grain holds the concealment crossfade");
+_Static_assert(LK_WS_HS * LK_SLOW_FLOOR_PCT / 100 >= LK_N / 2, "at the slowest rate a block of input still needs at most 2 grains");
+static int    s_lk_stretch = 1;
+static float  s_ws_in[LK_WS_RING * 2], s_ws_mono[LK_WS_RING], s_ws_ola[LK_WS_HS * 2], s_ws_win[LK_WS_W], s_ws_mono_t[LK_WS_HS];
+static long long s_ws_w = 0, s_ws_prev = -1;   /* input frames written; the input start of the last grain (-1: none yet) */
+static double s_ws_ana = 0.0;                  /* the nominal input start of the next grain */
+static unsigned long long s_ws_grains;
+static void lk_ws_reset(void)
+{
+    if (s_ws_win[LK_WS_HS] == 0.0f) for (int i = 0; i < LK_WS_W; i++) s_ws_win[i] = 0.5f - 0.5f * cosf(6.28318530718f * (float)i / (float)LK_WS_W);
+    memset(s_ws_in, 0, sizeof s_ws_in); memset(s_ws_mono, 0, sizeof s_ws_mono); memset(s_ws_ola, 0, sizeof s_ws_ola);
+    s_ws_w = 0; s_ws_prev = -1; s_ws_ana = 0.0; s_ws_grains = 0;
+}
+static inline float lk_ws_x(long long i, int c) { return s_ws_in[(size_t)(i & (LK_WS_RING - 1)) * 2 + c]; }   /* before the first frame: the ring's zeros */
+static inline float lk_ws_mono(long long i) { return s_ws_mono[(size_t)(i & (LK_WS_RING - 1))]; }   /* L + R, kept for the search */
+/* The best input start in nom +- LK_WS_TOL to continue the last grain (whose natural continuation starts at want). */
+static long long lk_ws_search(long long nom, long long want)
+{
+    double t_en = 0.0;
+    for (int i = 0; i < LK_WS_HS; i++) { s_ws_mono_t[i] = lk_ws_mono(want + i); t_en += (double)s_ws_mono_t[i] * s_ws_mono_t[i]; }
+    if (t_en < 1e-9) return nom;   /* silence: nothing to align */
+    long long best = nom; double best_v = -1e30;
+    for (int pass = 0; pass < 2; pass++) {
+        const long long lo = pass ? best - 3 : nom - LK_WS_TOL, hi = pass ? best + 3 : nom + LK_WS_TOL;
+        const int step = pass ? 1 : 4, stride = pass ? 1 : 2;
+        const long long from = best;
+        for (long long st = lo; st <= hi; st += step) {
+            if (pass && (st < nom - LK_WS_TOL || st > nom + LK_WS_TOL)) continue;
+            float xy = 0.0f, yy = 0.0f;
+            const size_t k0 = (size_t)(st & (LK_WS_RING - 1));
+            if (k0 + LK_WS_HS <= LK_WS_RING) { const float* y = &s_ws_mono[k0];   /* no wrap: a straight loop the compiler vectorises */
+                for (int i = 0; i < LK_WS_HS; i += stride) { xy += s_ws_mono_t[i] * y[i]; yy += y[i] * y[i]; } }
+            else for (int i = 0; i < LK_WS_HS; i += stride) { const float y = lk_ws_mono(st + i); xy += s_ws_mono_t[i] * y; yy += y * y; }
+            const double v = yy > 1e-12f ? xy / sqrt((double)yy) : -1e30;
+            if (v > best_v || (pass && st == from && v >= best_v)) { best_v = v; best = st; }
+        }
+        if (!pass) best_v = -1e30;   /* the fine pass compares at full resolution only */
+    }
+    return best;
+}
+/* One block of input (LK_N frames) at the rate `step` (input frames per output frame): the finished output frames into out (at most cap), and in
+ * *extra the output frames made over the input consumed (what a refill pays back). */
+static u32 lk_ws_block(const float* in, double step, float* out, u32 cap, double* extra)
+{
+    for (u32 i = 0; i < LK_N; i++) { const size_t j = (size_t)((s_ws_w + i) & (LK_WS_RING - 1)), k = j * 2;
+        s_ws_in[k] = in[i * 2]; s_ws_in[k + 1] = in[i * 2 + 1]; s_ws_mono[j] = in[i * 2] + in[i * 2 + 1]; }
+    s_ws_w += LK_N;
+    const double ha = step * LK_WS_HS;
+    u32 m = 0;
+    while (m + LK_WS_HS <= cap) {
+        const long long nom = (long long)floor(s_ws_ana + 0.5);
+        if (nom + LK_WS_TOL + LK_WS_W > s_ws_w) break;   /* the search and the grain need input not here yet */
+        const long long st = s_ws_prev < 0 ? nom : lk_ws_search(nom, s_ws_prev + LK_WS_HS);
+        for (int i = 0; i < LK_WS_HS; i++)
+            for (int c = 0; c < 2; c++) {
+                out[(m + (u32)i) * 2 + c] = s_ws_ola[i * 2 + c] + s_ws_win[i] * lk_ws_x(st + i, c);
+                s_ws_ola[i * 2 + c] = s_ws_win[LK_WS_HS + i] * lk_ws_x(st + LK_WS_HS + i, c);
+            }
+        m += LK_WS_HS; s_ws_prev = st; s_ws_ana += ha; *extra += LK_WS_HS - ha; s_ws_grains++;
+    }
+    if (s_ws_w - (long long)s_ws_ana > LK_WS_RING - 2 * LK_WS_TOL - LK_WS_W) s_ws_ana = (double)(s_ws_w - LK_WS_TOL - LK_WS_W);   /* never: a guard */
+    return m;
+}
